# ====================================
# Unreal Engine 5 .gitignore
# ====================================

# Temporary build, cache and intermediate folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Auto-generated project files (can be regenerated with Switch Unreal Engine Version / Generate Project Files)
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.vscode/
.vs/
.idea/

# Plugins temporary files
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Package builds (Shipping/Development executables)
Packaged/
Builds/
Release/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Crash logs and trace files
*.log
*.dmp
*.crashdump
*.trace
